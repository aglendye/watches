# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string (Vercel's Neon integration sets this for you in production).
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Gmail address and a 16-character Google app password, for password-reset codes.
# Leave empty locally: codes are then printed in the terminal running `npm run dev`.
SMTP_USER=
SMTP_PASS=

# Optional: send from a different "from" address than SMTP_USER (must be allowed by Gmail).
# SMTP_FROM=

# Optional: force the plain TCP Postgres driver instead of Neon's HTTP driver.
# DB_DRIVER=pg
